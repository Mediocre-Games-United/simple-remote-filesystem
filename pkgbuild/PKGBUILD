pkgname=simplerfs
pkgver=0.1.0
pkgrel=1
pkgdesc="Simple Remote Filesystem"
arch=("x86_64")
depends=("fuse3")
options=('!debug')
makedepends=("tar" "git")

source=('git+https://github.com/Mediocre-Games-United/simple-remote-filesystem.git' 'bin.tar.gz::https://github.com/Mediocre-Games-United/simple-remote-filesystem/releases/download/v0.1.0/srf-release-v0.1.0-linux-x86_64.tar.gz')
sha256sums=('SKIP' 'SKIP')

package() {
    cd $srcdir
    tar -xzf bin.tar.gz

    install -Dm755 "export/launcher" "$pkgdir/usr/bin/simplerfs"

    cd "$srcdir/simple-remote-filesystem"
    install -Dm644 "simplerfs.service" \
    "$pkgdir/usr/lib/systemd/system/simplerfs.service"
}
